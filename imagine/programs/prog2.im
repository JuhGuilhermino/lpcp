main{} (

    int a <- 0;
    int cont1 <- 0;
    int cont2 <- 0;
    int cont3 <- 0;
    int cont4 <- 0;

    get{a};

    until {a > 0} perform (

        if {a >= 0 && a <= 25} (
            cont1 <- cont1 + 1;
        )

        else if {a <= 50} (
            cont2 <- cont2 + 1;
        )

        else if {a <= 75} (
            cont3 <- cont3 + 1;
        )
        
        else if {a <= 100} (
            cont4 <- cont4 + 1;
        )

        endif;

        get{a};

    );

    shout{cont1};
    shout{cont2};
    shout{cont3};
    shout{cont4};

)