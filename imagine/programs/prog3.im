    matrix<int> mtx2 <- zeros(l2, c2);
    get{mtx2};

    if {l1 == l2 && c1 == c2} (
        shout{"soma das matrizes:"};
        shout{a+b};
    )
    else (
        shout{"soma impossível!!! dimensões das matrizes são diferentes"};
    )
    endif

    if {c1 == l2} (
        shout{a*b};
    )
    else(
